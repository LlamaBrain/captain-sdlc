{
  "hooks": {
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "node \"${CODEX_PLUGIN_ROOT}/scripts/user-prompt.mjs\"",
        "commandWindows": "\"${CODEX_PLUGIN_ROOT}/bin/captain-hook.exe\" \"${CODEX_PLUGIN_ROOT}/scripts/user-prompt.mjs\""
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "command": "node \"${CODEX_PLUGIN_ROOT}/scripts/mutation-gate.mjs\"",
        "commandWindows": "\"${CODEX_PLUGIN_ROOT}/bin/captain-hook.exe\" \"${CODEX_PLUGIN_ROOT}/scripts/mutation-gate.mjs\""
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node \"${CODEX_PLUGIN_ROOT}/scripts/completion-gate.mjs\"",
        "commandWindows": "\"${CODEX_PLUGIN_ROOT}/bin/captain-hook.exe\" \"${CODEX_PLUGIN_ROOT}/scripts/completion-gate.mjs\""
      }
    ]
  }
}
