{
  "description": "Fail-closed Captain SDLC implementation routing and completion gates.",
  "hooks": {
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "node -e \"import(require('node:url').pathToFileURL(require('node:path').join(process.env.PLUGIN_ROOT,'scripts','user-prompt.mjs')).href)\"", "timeout": 10 }] }],
    "PreToolUse": [{ "matcher": "*", "hooks": [{ "type": "command", "command": "node -e \"import(require('node:url').pathToFileURL(require('node:path').join(process.env.PLUGIN_ROOT,'scripts','mutation-gate.mjs')).href)\"", "timeout": 10 }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "node -e \"import(require('node:url').pathToFileURL(require('node:path').join(process.env.PLUGIN_ROOT,'scripts','completion-gate.mjs')).href)\"", "timeout": 10 }] }]
  }
}
